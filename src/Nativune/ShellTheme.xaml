<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Restrained opaque surfaces. Keep these keys stable for native views. -->
  <SolidColorBrush x:Key="CanvasBrush" Color="#030303" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#121212" />
  <SolidColorBrush x:Key="RaisedBrush" Color="#212121" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAAAAA" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FF0033" />
  <SolidColorBrush x:Key="FocusStrokeBrush" Color="#FF0033" />
  <Color x:Key="FocusStrokeColorOuter">#FF0033</Color>
  <Color x:Key="FocusStrokeColorInner">#FFFFFF</Color>
  <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FF0033" />
  <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#FFFFFF" />

  <SolidColorBrush x:Key="SeparatorBrush" Color="#3A3A3A" />

  <!-- WinUI default control state resource names. Normal text never sits on red. -->
  <SolidColorBrush x:Key="ButtonBackground" Color="#212121" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D2D2D" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3A3A3A" />
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#121212" />
  <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#777777" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#AAAAAA" />
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#373737" />
  <SolidColorBrush x:Key="ToggleButtonBackground" Color="#212121" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2D2D2D" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#3A3A3A" />
  <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#777777" />

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <!-- Dark native controls use Light2 for checked fills, slider accents
           and focused underlines. High contrast keeps native system colors. -->
      <Color x:Key="SystemAccentColor">#FF0033</Color>
      <Color x:Key="SystemAccentColorLight2">#FF0033</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <!-- Use the user's OS colors; never force the dark palette in HC mode. -->
      <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
      <SolidColorBrush x:Key="RaisedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="FocusStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />

      <SolidColorBrush x:Key="SeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

      <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
