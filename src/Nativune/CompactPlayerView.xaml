<UserControl
    x:Class="Nativune.CompactPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativune"
    MinWidth="800"
    MinHeight="180"
    AutomationProperties.Name="Compact music player"
    Background="{ThemeResource CanvasBrush}">
    <Grid x:Name="RootGrid" Background="{ThemeResource CanvasBrush}">
        <Grid.Resources>
            <ResourceDictionary>
            <!-- Compact keeps disabled secondary controls quiet and transparent. The state
                 colors remain native-resource driven and are replaced with system colors in HC. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#00000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#121212" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#212121" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#00000000" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#AAAAAA" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#00000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#3A3A3A" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#AAAAAA" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#00000000" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="#00000000" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#121212" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#212121" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#00000000" />
            <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#AAAAAA" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#00000000" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#3A3A3A" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#AAAAAA" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#00000000" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#212121" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2D2D2D" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#3A3A3A" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#00000000" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminate" Color="#121212" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminatePointerOver" Color="#212121" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminatePressed" Color="#2D2D2D" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminateDisabled" Color="#00000000" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#AAAAAA" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminate" Color="#AAAAAA" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminatePointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminatePressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminateDisabled" Color="#AAAAAA" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#FF0033" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#FF0033" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#FF0033" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="#00000000" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminate" Color="#3A3A3A" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminatePointerOver" Color="#AAAAAA" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminatePressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminateDisabled" Color="#00000000" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminate" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminatePointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminatePressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminateDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminate" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminatePointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminatePressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminateDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminate" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminatePointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminatePressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminateDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Canvas x:Name="LayoutCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent">
            <local:CompactArtworkCanvas x:Name="Artwork" Width="112" Height="112" />
            <local:CompactMarqueeText x:Name="Title" Width="452" Height="32" Background="Transparent" />
            <TextBlock x:Name="InlineStatus" Width="452" Height="16"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource SecondaryTextBrush}" />
            <Grid x:Name="ProgressRow" Width="632" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Elapsed" Grid.Column="0" Width="44"
                           FontSize="12" HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
                <Grid Grid.Column="1" MinWidth="80">
                    <ProgressBar x:Name="SeekProgress" Minimum="0" Maximum="1000"
                                 Height="4" VerticalAlignment="Center" Visibility="Collapsed"
                                 IsHitTestVisible="False" Foreground="{ThemeResource AccentBrush}"
                                 Background="{ThemeResource SecondaryTextBrush}" />
                    <local:CompactSeekSlider x:Name="Seek" Height="40"
                                             Minimum="0" Maximum="1000" StepFrequency="1" />
                </Grid>
                <TextBlock x:Name="Duration" Grid.Column="3"
                           FontSize="12" TextAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </Grid>

            <Button x:Name="Previous" Width="40" Height="40"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" />
            <Button x:Name="PlayPause" Width="48" Height="48" CornerRadius="24"
                    Background="{ThemeResource PrimaryTextBrush}"
                    Foreground="{ThemeResource CanvasBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="0">
                <Button.Resources>
                    <ResourceDictionary>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F1F1F1" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#212121" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#030303" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#030303" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#030303" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#AAAAAA" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#00000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#00000000" />
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Button.Resources>
            </Button>
            <Button x:Name="Next" Width="40" Height="40"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" />
            <ToggleButton x:Name="Like" Width="40" Height="40" IsThreeState="True"
                          Background="Transparent" BorderBrush="Transparent" BorderThickness="0" />
            <ToggleButton x:Name="Dislike" Width="40" Height="40" IsThreeState="True"
                          Background="Transparent" BorderBrush="Transparent" BorderThickness="0" />
            <Button x:Name="Repeat" Width="40" Height="40"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                <Grid Width="24" Height="24">
                    <ContentControl x:Name="RepeatIcon"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                    <TextBlock x:Name="RepeatMarker"
                               Width="10"
                               Height="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               FontSize="9"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource FocusStrokeBrush}" />
                </Grid>
            </Button>
            <Button x:Name="Shuffle" Width="40" Height="40"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                <Grid Width="24" Height="24">
                    <ContentControl x:Name="ShuffleIcon"
                                    Width="20" Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                    <Ellipse x:Name="ShuffleMarker" Width="6" Height="6"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Visibility="Collapsed"
                             Fill="{ThemeResource FocusStrokeBrush}" />
                </Grid>
            </Button>
            <Button x:Name="Volume" Width="40" Height="40"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                <Button.ContextFlyout>
                    <Flyout x:Name="VolumePopup" Placement="Bottom">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="0" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Grid x:Name="VolumePopupSurface"
                              Width="240"
                              Height="48"
                              ColumnSpacing="8"
                              AutomationProperties.Name="App output volume control">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <local:CompactVolumeSlider x:Name="VolumeSlider"
                                                       Grid.Column="0"
                                                       Width="180"
                                                       Height="40"
                                                       Minimum="0"
                                                       Maximum="1000"
                                                       StepFrequency="1" />
                            <TextBlock x:Name="VolumeValue"
                                       Grid.Column="1"
                                       Width="52"
                                       Height="32"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource PrimaryTextBrush}" />
                        </Grid>
                    </Flyout>
                </Button.ContextFlyout>
            </Button>
            <Button x:Name="Timer" Width="148" Height="40"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    Foreground="{ThemeResource SecondaryTextBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <ContentControl x:Name="TimerIcon" Width="16" Height="16" />
                    <TextBlock x:Name="TimerText" Text="Pause timer" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="ReturnToFull" Width="36" Height="36"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" />
            <Button x:Name="More" Width="36" Height="36"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                <Button.ContextFlyout>
                    <MenuFlyout x:Name="MoreMenu">
                        <MenuFlyoutItem x:Name="SettingsItem" Text="Settings..." />
                        <MenuFlyoutItem x:Name="StatusItem" Text="Application status" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="TopmostItem" Text="Keep window on top" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="VersionItem"
                                           IsEnabled="False" />
                    </MenuFlyout>
                </Button.ContextFlyout>
            </Button>
            <Button x:Name="Minimize" Width="36" Height="36"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" />
            <Button x:Name="Close" Width="36" Height="36"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" />
        </Canvas>
    </Grid>
</UserControl>
