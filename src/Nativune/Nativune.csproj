<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <UseWinUI>true</UseWinUI>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <UpdaterTestHooks Condition="'$(UpdaterTestHooks)' == ''">false</UpdaterTestHooks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefineConstants Condition="'$(UpdaterTestHooks)' == 'true'">$(DefineConstants);NATIVUNE_UPDATER_TEST_HOOKS</DefineConstants>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>portable</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app-icon\nativune.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Nativune</AssemblyName>
    <Version>0.1.14</Version>
    <Product>Nativune</Product>
    <Description>A native Windows shell for the official YouTube Music website.</Description>
    <Authors>Hantu-Raya</Authors>
    <Copyright>Copyright © 2026 Hantu-Raya</Copyright>
    <RepositoryUrl>https://github.com/Hantu-Raya/Nativune</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>Nativune</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="ShellApplication.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <Page Include="ShellTheme.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="WebHostWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="CompactPlayerView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="SettingsDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../assets/native-icons/raster/**/*.png"
             Exclude="../../assets/native-icons/raster/**/notifications*.png">
      <Link>Assets\NativeIcons\raster\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>Assets\NativeIcons\raster\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="../../assets/app-icon/nativune.ico">
      <Link>Assets\nativune.ico</Link>
      <TargetPath>Assets\nativune.ico</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <EmbeddedResource Include="../../assets/native-icons/raster/16/*.png"
                      LogicalName="Nativune.NativeIcons.16.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/native-icons/raster/20/*.png"
                      LogicalName="Nativune.NativeIcons.20.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/native-icons/raster/24/*.png"
                      LogicalName="Nativune.NativeIcons.24.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/native-icons/raster/25/*.png"
                      LogicalName="Nativune.NativeIcons.25.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/native-icons/raster/30/*.png"
                      LogicalName="Nativune.NativeIcons.30.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/native-icons/raster/32/*.png"
                      LogicalName="Nativune.NativeIcons.32.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/native-icons/raster/40/*.png"
                      LogicalName="Nativune.NativeIcons.40.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/native-icons/raster/48/*.png"
                      LogicalName="Nativune.NativeIcons.48.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/native-icons/raster/64/*.png"
                      LogicalName="Nativune.NativeIcons.64.%(Filename)%(Extension)" />
    <EmbeddedResource Remove="../../assets/native-icons/raster/*/notifications*.png" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
