<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app-icon\nativune.ico</ApplicationIcon>
    <AssemblyName>Nativune.Setup</AssemblyName>
    <RootNamespace>Nativune.Installer</RootNamespace>
    <Version>0.1.23</Version>
    <RepositoryUrl>https://github.com/Hantu-Raya/Nativune</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InstallerTestHooks Condition="'$(InstallerTestHooks)' == ''">false</InstallerTestHooks>
    <DefineConstants Condition="'$(InstallerTestHooks)' == 'true'">$(DefineConstants);INSTALLER_TEST_HOOKS</DefineConstants>
  </PropertyGroup>
</Project>
